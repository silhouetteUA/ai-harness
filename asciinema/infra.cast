[0.848, "o", "\u001b[A\u001b[100D\u001b[27mf\u001b[27mo\u001b[27mr\u001b[27m \u001b[27mh\u001b[27mo\u001b[27ms\u001b[27mt\u001b[27m \u001b[27mi\u001b[27mn\u001b[27m \u001b[27mr\u001b[27me\u001b[27mg\u001b[27mi\u001b[27ms\u001b[27mt\u001b[27mr\u001b[27my\u001b[27m.\u001b[27ml\u001b[27mo\u001b[27mc\u001b[27ma\u001b[27ml\u001b[27mh\u001b[27mo\u001b[27ms\u001b[27mt\u001b[27m \u001b[27mk\u001b[27ma\u001b[27mg\u001b[27me\u001b[27mn\u001b[27mt\u001b[27m.\u001b[27ml\u001b[27mo\u001b[27mc\u001b[27ma\u001b[27ml\u001b[27mh\u001b[27mo\u001b[27ms\u001b[27mt\u001b[27m \u001b[27mp\u001b[27mh\u001b[27mo\u001b[27me\u001b[27mn\u001b[27mi\u001b[27mx\u001b[27m.\u001b[27ml\u001b[27mo\u001b[27mc\u001b[27ma\u001b[27ml\u001b[27mh\u001b[27mo\u001b[27ms\u001b[27mt\u001b[27m \u001b[27mq\u001b[27md\u001b[27mr\u001b[27ma\u001b[27mn\u001b[27mt\u001b[27m.\u001b[27ml\u001b[27mo\u001b[27mc\u001b[27ma\u001b[27ml\u001b[27mh\u001b[27mo\u001b[27ms\u001b[27mt\u001b[27m;\u001b[27m \u001b[27md\u001b[27mo\u001b[27m \u001b[27mp\u001b[27ma\u001b[27mg\u001b[27me\u001b[27m=\u001b[27m$\u001b[27m(\u001b[27mc\u001b[27mu\u001b[27mr\u001b[27ml\u001b[27m \u001b[27m-\u001b[27ms\u001b[27m \u001b[27m\"\u001b[27mh\u001b[27mt\u001b[27mt\u001b[27mp\u001b[27m:\u001b[27m/\u001b[27m/\u001b[27m$\u001b[27mh\u001b[27mo\u001b[27ms\u001b[27mt\u001b[27m:\u001b[27m8\u001b[27m0\u001b[27m8\u001b[27m1\u001b[27m\"\u001b[27m)\u001b[27m;\u001b[27m \u001b[27mp\u001b[27mr\u001b[27mi\u001b[27mn\u001b[27mt\u001b[27mf\u001b[27m \u001b[27m\"\u001b[27m%\u001b[27m-\u001b[27m2\u001b[27m5\u001b[27ms\u001b[27m \u001b[27m→\u001b[27m \u001b[27mH\u001b[27mT\u001b[27mT\u001b[27mP\u001b[27m \u001b[27m%\u001b[27ms\u001b[27m \u001b[27m→\u001b[27m \u001b[27m%\u001b[27ms\u001b[27m\\\u001b[27mn\u001b[27m\"\u001b[27m \"\u001b[27m$\u001b[27mh\u001b[27mo\u001b[27ms\u001b[27mt\u001b[27m\"\u001b[27m \u001b[27m\"\u001b[27m$\u001b[27m(\u001b[27mc\u001b[27mu\u001b["]
