[0.000, "o", ",\r\n          \u001b[32m+\u001b[0m\u001b[0m {\r\n              \u001b[32m+\u001b[0m\u001b[0m name  = \"applicationSet.enabled\"\r\n              \u001b[32m+\u001b[0m\u001b[0m type  = \"\"\r\n              \u001b[32m+\u001b[0m\u001b[0m value = \"false\"\r\n            },\r\n          \u001b[32m+\u001b[0m\u001b[0m {\r\n              \u001b[32m+\u001b[0m\u001b[0m name  = \"configs.cm.application.resourceTrackingMethod\"\r\n              \u001b[32m+\u001b[0m\u001b[0m type  = \"\"\r\n              \u001b[32m+\u001b[0m\u001b[0m value = \"annotation\"\r\n            },\r\n        ]\r\n      \u001b[32m+\u001b[0m\u001b[0m set_wo                     = (write-only attribute)\r\n      \u001b[32m+\u001b[0m\u001b[0m skip_crds                  = false\r\n      \u001b[32m+\u001b[0m\u001b[0m status                     = \"deployed\"\r\n      \u001b[32m+\u001b[0m\u001b[0m take_ownership             = false\r\n      \u001b[32m+\u001b[0m\u001b[0m timeout                    = 300\r\n      \u001b[32m+\u001b[0m\u001b[0m upgrade_install            = false\r\n      \u001b[32m+\u001b[0m\u001b[0m verify                     = false\r\n      \u001b[32m+\u001b[0m\u001b[0m version                    = \"6.7.11\"\r\n      \u001b[32m+\u001b[0m\u001b[0m wait                       = true\r\n      \u001b[32m+\u001b[0m\u001b[0m wait_for_jobs              = false\r\n  "]
